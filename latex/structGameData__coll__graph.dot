digraph "GameData"
{
 // LATEX_PDF_SIZE
  edge [fontname="Helvetica",fontsize="10",labelfontname="Helvetica",labelfontsize="10"];
  node [fontname="Helvetica",fontsize="10",shape=record];
  Node1 [label="{GameData\n|+ board\l|}",height=0.2,width=0.4,color="black", fillcolor="grey75", style="filled", fontcolor="black",tooltip="Holds the main game data: board and players."];
  Node2 -> Node1 [color="grey25",fontsize="10",style="solid",label=" +player1\n+player2" ,arrowhead="odiamond"];
  Node2 [label="{Player\n|- name\l- mana\l- isAI\l- myTurn\l- defeated\l- skippedTurns\l|+ Player()\l+ getName()\l+ getMana()\l+ setMana()\l+ getAI()\l+ getMyTurn()\l+ setMyTurn()\l+ getDefeated()\l+ setDefeated()\l+ getSkippedTurns()\l+ setSkippedTurns()\l+ addMana()\l+ subtractMana()\l}",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$classPlayer.html",tooltip="Represents a player in the game (human or AI)."];
}
