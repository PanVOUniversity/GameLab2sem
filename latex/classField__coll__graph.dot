digraph "Field"
{
 // LATEX_PDF_SIZE
  edge [fontname="Helvetica",fontsize="10",labelfontname="Helvetica",labelfontsize="10"];
  node [fontname="Helvetica",fontsize="10",shape=record];
  Node1 [label="{Field\n|# x\l# y\l# type\l|+ Field()\l+ ~Field()\l+ getUnit()\l+ setUnit()\l+ getX()\l+ getY()\l+ getType()\l+ applyEffect()\l+ getDefenseBonus()\l+ canEnter()\l+ onEnter()\l+ onLeave()\l+ getSymbol()\l}",height=0.2,width=0.4,color="black", fillcolor="grey75", style="filled", fontcolor="black",tooltip="Represents a field (tile) on the game board. Base class for all field types."];
  Node2 -> Node1 [color="grey25",fontsize="10",style="solid",label=" #unit" ,arrowhead="odiamond"];
  Node2 [label="{Unit\n|# name\l# moveDistance\l# attackDistance\l# currentHealth\l# maxHealth\l# damage\l# isPlayerUnit\l# currentWill\l# maxWill\l|+ Unit()\l+ ~Unit()\l+ getName()\l+ getMoveDistance()\l+ getAttackDistance()\l+ getCurrentHealth()\l+ getMaxHealth()\l+ getDamage()\l+ getPlayer()\l+ getWill()\land 9 more...\l}",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$classUnit.html",tooltip="Represents a unit in the game (base class for all units)."];
}
