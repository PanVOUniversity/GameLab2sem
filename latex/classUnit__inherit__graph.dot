digraph "Unit"
{
 // LATEX_PDF_SIZE
  edge [fontname="Helvetica",fontsize="10",labelfontname="Helvetica",labelfontsize="10"];
  node [fontname="Helvetica",fontsize="10",shape=record];
  Node1 [label="{Unit\n|# name\l# moveDistance\l# attackDistance\l# currentHealth\l# maxHealth\l# damage\l# isPlayerUnit\l# currentWill\l# maxWill\l|+ Unit()\l+ ~Unit()\l+ getName()\l+ getMoveDistance()\l+ getAttackDistance()\l+ getCurrentHealth()\l+ getMaxHealth()\l+ getDamage()\l+ getPlayer()\l+ getWill()\land 9 more...\l}",height=0.2,width=0.4,color="black", fillcolor="grey75", style="filled", fontcolor="black",tooltip="Represents a unit in the game (base class for all units)."];
  Node1 -> Node2 [dir="back",color="midnightblue",fontsize="10",style="solid",arrowtail="onormal"];
  Node2 [label="{Archer\n||+ Archer()\l+ ~Archer()\l+ updateAttackDistance()\l+ getSymbol()\l}",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$classArcher.html",tooltip=" "];
  Node1 -> Node3 [dir="back",color="midnightblue",fontsize="10",style="solid",arrowtail="onormal"];
  Node3 [label="{Cannon\n|- _direction\l|+ Cannon()\l+ ~Cannon()\l+ setDirection()\l+ getDirection()\l+ fire()\l+ useAbility()\l+ getSymbol()\l- _findFriendlyNearby()\l- _findEnemyInRange()\l- _findEmptyFieldInRange()\l- _findFriendlyFortressNearby()\l}",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$classCannon.html",tooltip=" "];
  Node1 -> Node4 [dir="back",color="midnightblue",fontsize="10",style="solid",arrowtail="onormal"];
  Node4 [label="{Engineer\n||+ Engineer()\l+ ~Engineer()\l+ createFortress()\l+ createManaMine()\l+ createTrap()\l+ getSymbol()\l}",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$classEngineer.html",tooltip=" "];
  Node1 -> Node5 [dir="back",color="midnightblue",fontsize="10",style="solid",arrowtail="onormal"];
  Node5 [label="{Infantry\n||+ Infantry()\l+ ~Infantry()\l+ counterAttack()\l+ getSymbol()\l}",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$classInfantry.html",tooltip=" "];
  Node1 -> Node6 [dir="back",color="midnightblue",fontsize="10",style="solid",arrowtail="onormal"];
  Node6 [label="{Priest\n||+ Priest()\l+ ~Priest()\l+ pray()\l+ getSymbol()\l}",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$classPriest.html",tooltip=" "];
}
