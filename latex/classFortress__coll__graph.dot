digraph "Fortress"
{
 // LATEX_PDF_SIZE
  edge [fontname="Helvetica",fontsize="10",labelfontname="Helvetica",labelfontsize="10"];
  node [fontname="Helvetica",fontsize="10",shape=record];
  Node1 [label="{Fortress\n|- strength\l- maxStrength\l|+ Fortress()\l+ ~Fortress()\l+ getStrength()\l+ setStrength()\l+ getMaxStrength()\l+ applyEffect()\l+ getDefenseBonus()\l+ canEnter()\l+ onEnter()\l+ onLeave()\l+ getOwner()\l+ setOwner()\l+ getSymbol()\l}",height=0.2,width=0.4,color="black", fillcolor="grey75", style="filled", fontcolor="black",tooltip="Represents a Fortress field on the board, which provides defense and can be captured or destroyed."];
  Node2 -> Node1 [dir="back",color="midnightblue",fontsize="10",style="solid",arrowtail="onormal"];
  Node2 [label="{Field\n|# x\l# y\l# type\l|+ Field()\l+ ~Field()\l+ getUnit()\l+ setUnit()\l+ getX()\l+ getY()\l+ getType()\l+ applyEffect()\l+ getDefenseBonus()\l+ canEnter()\l+ onEnter()\l+ onLeave()\l+ getSymbol()\l}",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$classField.html",tooltip="Represents a field (tile) on the game board. Base class for all field types."];
  Node3 -> Node2 [color="grey25",fontsize="10",style="solid",label=" #unit" ,arrowhead="odiamond"];
  Node3 [label="{Unit\n|# name\l# moveDistance\l# attackDistance\l# currentHealth\l# maxHealth\l# damage\l# isPlayerUnit\l# currentWill\l# maxWill\l|+ Unit()\l+ ~Unit()\l+ getName()\l+ getMoveDistance()\l+ getAttackDistance()\l+ getCurrentHealth()\l+ getMaxHealth()\l+ getDamage()\l+ getPlayer()\l+ getWill()\land 9 more...\l}",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$classUnit.html",tooltip="Represents a unit in the game (base class for all units)."];
  Node4 -> Node1 [color="grey25",fontsize="10",style="solid",label=" -owner" ,arrowhead="odiamond"];
  Node4 [label="{Player\n|- name\l- mana\l- isAI\l- myTurn\l- defeated\l- skippedTurns\l|+ Player()\l+ getName()\l+ getMana()\l+ setMana()\l+ getAI()\l+ getMyTurn()\l+ setMyTurn()\l+ getDefeated()\l+ setDefeated()\l+ getSkippedTurns()\l+ setSkippedTurns()\l+ addMana()\l+ subtractMana()\l}",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$classPlayer.html",tooltip="Represents a player in the game (human or AI)."];
}
