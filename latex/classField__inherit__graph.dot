digraph "Field"
{
 // LATEX_PDF_SIZE
  edge [fontname="Helvetica",fontsize="10",labelfontname="Helvetica",labelfontsize="10"];
  node [fontname="Helvetica",fontsize="10",shape=record];
  Node1 [label="{Field\n|# unit\l# x\l# y\l# type\l|+ Field()\l+ ~Field()\l+ getUnit()\l+ setUnit()\l+ getX()\l+ getY()\l+ getType()\l+ applyEffect()\l+ getDefenseBonus()\l+ canEnter()\l+ onEnter()\l+ onLeave()\l+ getSymbol()\l}",height=0.2,width=0.4,color="black", fillcolor="grey75", style="filled", fontcolor="black",tooltip="Represents a field (tile) on the game board. Base class for all field types."];
  Node1 -> Node2 [dir="back",color="midnightblue",fontsize="10",style="solid",arrowtail="onormal"];
  Node2 [label="{BombedField\n|- timer\l- explosionDamage\l|+ BombedField()\l+ ~BombedField()\l+ applyEffect()\l+ canEnter()\l+ onEnter()\l+ shouldExplode()\l+ explode()\l+ getSymbol()\l}",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$classBombedField.html",tooltip="Field that acts as a trap and explodes after a timer or when triggered by a unit (Bombed Field)."];
  Node1 -> Node3 [dir="back",color="midnightblue",fontsize="10",style="solid",arrowtail="onormal"];
  Node3 [label="{BurnedField\n|- duration\l- damagePerTurn\l|+ BurnedField()\l+ ~BurnedField()\l+ applyEffect()\l+ getDefenseBonus()\l+ canEnter()\l+ getSymbol()\l}",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$classBurnedField.html",tooltip="Field that deals damage to units each turn for a limited duration (Burned Field)."];
  Node1 -> Node4 [dir="back",color="midnightblue",fontsize="10",style="solid",arrowtail="onormal"];
  Node4 [label="{Fortress\n|- strength\l- maxStrength\l- owner\l|+ Fortress()\l+ ~Fortress()\l+ getStrength()\l+ setStrength()\l+ getMaxStrength()\l+ applyEffect()\l+ getDefenseBonus()\l+ canEnter()\l+ onEnter()\l+ onLeave()\l+ getOwner()\l+ setOwner()\l+ getSymbol()\l}",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$classFortress.html",tooltip="Represents a Fortress field on the board, which provides defense and can be captured or destroyed."];
  Node1 -> Node5 [dir="back",color="midnightblue",fontsize="10",style="solid",arrowtail="onormal"];
  Node5 [label="{Hill\n||+ Hill()\l+ ~Hill()\l+ getDefenseBonus()\l+ canEnter()\l+ getSymbol()\l}",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$classHill.html",tooltip="Represents a Hill field on the board, which provides a defense bonus."];
  Node1 -> Node6 [dir="back",color="midnightblue",fontsize="10",style="solid",arrowtail="onormal"];
  Node6 [label="{HospitalField\n|- healPerTurn\l|+ HospitalField()\l+ ~HospitalField()\l+ applyEffect()\l+ canEnter()\l+ getSymbol()\l}",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$classHospitalField.html",tooltip="Field that heals units each turn (Hospital Field)."];
  Node1 -> Node7 [dir="back",color="midnightblue",fontsize="10",style="solid",arrowtail="onormal"];
  Node7 [label="{ManaMineField\n|- manaPerTurn\l|+ ManaMineField()\l+ ~ManaMineField()\l+ applyEffect()\l+ canEnter()\l+ generateMana()\l+ getSymbol()\l}",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$classManaMineField.html",tooltip="Field that generates mana for the owner each turn (Mana Mine Field)."];
  Node1 -> Node8 [dir="back",color="midnightblue",fontsize="10",style="solid",arrowtail="onormal"];
  Node8 [label="{ShieldedField\n|- duration\l|+ ShieldedField()\l+ ~ShieldedField()\l+ applyEffect()\l+ getDefenseBonus()\l+ canEnter()\l+ getSymbol()\l}",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$classShieldedField.html",tooltip="Field that provides a temporary shield to units (Shielded Field)."];
}
