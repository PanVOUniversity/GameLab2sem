@startuml
package "Game System" {
  [Main] as Main
  [Initialization] as Init
  [Board] as Board
  [Units] as Units
  [Fields] as Fields
  [Spells] as Spells
  [Players] as Players
  [AI] as AI
  [Commands Processing] as Commands
  [Functions (Game Logic)] as Functions
}

Main -- Init : uses
Main -- Players : manages
Main -- Board : manages
Main -- Commands : uses
Main -- AI : uses
Main -- Functions : uses

Init -- Board : creates
Init -- Players : creates

Commands -- Players : interacts with
Commands -- Board : interacts with
Commands -- Functions : uses
Commands -- Units : creates
Commands -- Spells : casts
Commands -- Fields : builds

AI -- Players : interacts with
AI -- Board : interacts with
AI -- Functions : uses
AI -- Units : creates
AI -- Spells : casts
AI -- Fields : builds

Functions -- Board : modifies
Functions -- Units : modifies
Functions -- Players : modifies
Functions -- Fields : modifies

Units <.. Fields : placed on
Spells .> Fields : affects
Spells .> Units : affects
Fields <|-- Hill : inherits
Fields <|-- Fortress : inherits
Fields <|-- ManaMineField : inherits
Fields <|-- BombedField : inherits
Fields <|-- BurnedField : inherits
Fields <|-- HospitalField : inherits
Fields <|-- ShieldedField : inherits
Units <|-- Infantry : inherits
Units <|-- Archer : inherits
Units <|-- Priest : inherits
Units <|-- Engineer : inherits
Units <|-- Cannon : inherits

@enduml
