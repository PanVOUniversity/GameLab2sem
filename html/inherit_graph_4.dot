digraph "Graphical Class Hierarchy"
{
 // LATEX_PDF_SIZE
  edge [fontname="Helvetica",fontsize="10",labelfontname="Helvetica",labelfontsize="10"];
  node [fontname="Helvetica",fontsize="10",shape=record];
  rankdir="LR";
  Node0 [label="Spell",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$classSpell.html",tooltip="Abstract base class for all spells in the game."];
  Node0 -> Node1 [dir="back",color="midnightblue",fontsize="10",style="solid",fontname="Helvetica"];
  Node1 [label="BombSpell",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$classBombSpell.html",tooltip="Spell that creates a bombed field (trap) at a target location (Bomb)."];
  Node0 -> Node2 [dir="back",color="midnightblue",fontsize="10",style="solid",fontname="Helvetica"];
  Node2 [label="CurseSpell",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$classCurseSpell.html",tooltip="Spell that reduces a unit's abilities (Curse). Damage to zero."];
  Node0 -> Node3 [dir="back",color="midnightblue",fontsize="10",style="solid",fontname="Helvetica"];
  Node3 [label="FireballSpell",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$classFireballSpell.html",tooltip="Spell that deals damage to a target unit (Fireball)."];
  Node0 -> Node4 [dir="back",color="midnightblue",fontsize="10",style="solid",fontname="Helvetica"];
  Node4 [label="MorogSpell",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$classMorogSpell.html",tooltip="Spell that changes owner of unit on the field."];
  Node0 -> Node5 [dir="back",color="midnightblue",fontsize="10",style="solid",fontname="Helvetica"];
  Node5 [label="TeleportSpell",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$classTeleportSpell.html",tooltip="Spell that teleports a unit to a new location (Teleport)."];
}
