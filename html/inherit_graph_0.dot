digraph "Graphical Class Hierarchy"
{
 // LATEX_PDF_SIZE
  edge [fontname="Helvetica",fontsize="10",labelfontname="Helvetica",labelfontsize="10"];
  node [fontname="Helvetica",fontsize="10",shape=record];
  rankdir="LR";
  Node0 [label="Field",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$classField.html",tooltip="Represents a field (tile) on the game board. Base class for all field types."];
  Node0 -> Node1 [dir="back",color="midnightblue",fontsize="10",style="solid",fontname="Helvetica"];
  Node1 [label="BombedField",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$classBombedField.html",tooltip="Field that acts as a trap and explodes after a timer or when triggered by a unit (Bombed Field)."];
  Node0 -> Node2 [dir="back",color="midnightblue",fontsize="10",style="solid",fontname="Helvetica"];
  Node2 [label="BurnedField",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$classBurnedField.html",tooltip="Field that deals damage to units each turn for a limited duration (Burned Field)."];
  Node0 -> Node3 [dir="back",color="midnightblue",fontsize="10",style="solid",fontname="Helvetica"];
  Node3 [label="Fortress",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$classFortress.html",tooltip="Represents a Fortress field on the board, which provides defense and can be captured or destroyed."];
  Node0 -> Node4 [dir="back",color="midnightblue",fontsize="10",style="solid",fontname="Helvetica"];
  Node4 [label="Hill",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$classHill.html",tooltip="Represents a Hill field on the board, which provides a defense bonus."];
  Node0 -> Node5 [dir="back",color="midnightblue",fontsize="10",style="solid",fontname="Helvetica"];
  Node5 [label="HospitalField",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$classHospitalField.html",tooltip="Field that heals units each turn (Hospital Field)."];
  Node0 -> Node6 [dir="back",color="midnightblue",fontsize="10",style="solid",fontname="Helvetica"];
  Node6 [label="ManaMineField",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$classManaMineField.html",tooltip="Field that generates mana for the owner each turn (Mana Mine Field)."];
  Node0 -> Node7 [dir="back",color="midnightblue",fontsize="10",style="solid",fontname="Helvetica"];
  Node7 [label="ShieldedField",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$classShieldedField.html",tooltip="Field that provides a temporary shield to units (Shielded Field)."];
}
